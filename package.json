{
  "name": "@testmuai/mobilewright",
  "version": "0.1.0",
  "description": "TestMu.Ai driver for Mobilewright \u2014 run Mobilewright tests on TestMu.Ai real devices",
  "keywords": [
    "mobilewright",
    "testmu",
    "testmuai",
    "lambdatest",
    "appium",
    "webdriver",
    "mobile",
    "testing",
    "ios",
    "android"
  ],
  "license": "Apache-2.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amankansal-lt/testmuai-mobilewright.git"
  },
  "homepage": "https://github.com/amankansal-lt/testmuai-mobilewright#readme",
  "bugs": {
    "url": "https://github.com/amankansal-lt/testmuai-mobilewright/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-timeout 30000 test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@mobilewright/protocol": ">=0.0.56 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@mobilewright/protocol": {
      "optional": false
    }
  },
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@mobilewright/core": "^0.0.60",
    "@mobilewright/protocol": "^0.0.60",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
